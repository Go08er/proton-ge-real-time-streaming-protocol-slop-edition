+static BOOL is_http_url( const char *url )
+{
+    return url && (!strncasecmp( url, "http://", 7 ) || !strncasecmp( url, "https://", 8 ));
+}
+
+static const char *http_protocol_whitelist( const char *url )
+{
+    return !strncasecmp( url, "https://", 8 )
+            ? HTTPS_PROTOCOL_WHITELIST : HTTP_PROTOCOL_WHITELIST;
+}
+
+static const char *hls_protocol_whitelist( const char *url )
+{
+    return !strncasecmp( url, "https://", 8 )
+            ? HTTPS_HLS_PROTOCOL_WHITELIST : HTTP_HLS_PROTOCOL_WHITELIST;
+}
+
+static BOOL http_open_allows_urlmon_fallback( const char *url, int ret )
+{
+    /* In the pinned FFmpeg, TLS certificate/hostname failures return EIO and
+     * protocol-whitelist rejections return EINVAL.  Restrict the compatibility
+     * retry to plain HTTP media which reached probe/header validation. */
+    return url && !strncasecmp( url, "http://", 7 ) && ret == AVERROR_INVALIDDATA;
+}
+
 static BOOL is_http_hls_url( const char *url )
 {
     const char *cursor;
 
-    if (!url || (strncasecmp( url, "http://", 7 ) && strncasecmp( url, "https://", 8 ))) return FALSE;
+    if (!is_http_url( url )) return FALSE;
 
-    for (cursor = url; *cursor; cursor++)
+    cursor = url + (!strncasecmp( url, "http://", 7 ) ? 7 : 8);
+    while (*cursor && *cursor != '/' && *cursor != '?' && *cursor != '#') cursor++;
+    if (*cursor != '/') return FALSE;
+
+    for (; *cursor && *cursor != '?' && *cursor != '#'; cursor++)
         if (!strncasecmp( cursor, ".m3u8", 5 ) || !strncasecmp( cursor, "/hls_playlist/", 14 )) return TRUE;
 
     return FALSE;
@@ -874,6 +915,7 @@ NTSTATUS demuxer_create( void *arg )
     enum direct_network_url rtsp_kind;
     AVDictionary *options = NULL;
     char *direct_url = NULL;
+    NTSTATUS failure_status = STATUS_UNSUCCESSFUL;
     int i, ret;
 
     TRACE( "context %p, remote URL %s, mime %s\n", params->context,
@@ -893,23 +935,82 @@ NTSTATUS demuxer_create( void *arg )
     if (is_http_hls_url( params->url ))
     {
         const AVInputFormat *hls = av_find_input_format( "hls" );
+        const char *protocol_whitelist = hls_protocol_whitelist( params->url );
 
+        TRACE( "media-route=direct-hls\n" );
         /* HLS playlists need the source URL as their base URI so relative
          * segment URLs can be resolved.  The custom bytestream path only
          * exposes the downloaded manifest bytes, which breaks YouTube HLS
-         * streams used by VRChat's in-game video player. */
+         * streams used by VRChat's in-game video player.  Verify the root TLS
+         * connection and prevent an HTTPS-root playlist from downgrading.  The
+         * HLS-only crypto wrapper is required for AES-128 segments; its nested
+         * URL remains constrained by the same root-sensitive allowlist. */
+        if (av_dict_set( &options, "protocol_whitelist", protocol_whitelist, 0 ) < 0) goto failed;
+        if (av_dict_set_int( &options, "tls_verify", 1, 0 ) < 0) goto failed;
         demuxer->direct_url = TRUE;
         demuxer->io_timeout = HLS_IO_TIMEOUT_US;
         demuxer->ctx->interrupt_callback.callback = demuxer_interrupt_callback;
         demuxer->ctx->interrupt_callback.opaque = demuxer;
         demuxer_set_deadline( demuxer, HLS_IO_TIMEOUT_US );
-        if ((ret = avformat_open_input( &demuxer->ctx, params->url, hls, NULL )) < 0)
+        if ((ret = avformat_open_input( &demuxer->ctx, params->url, hls, &options )) < 0)
         {
             demuxer_set_deadline( demuxer, 0 );
             ERR( "Failed to open HLS URL, error %s.\n", debugstr_averr(ret) );
             goto failed;
         }
         demuxer_set_deadline( demuxer, 0 );
+        av_dict_set( &options, "tls_verify", NULL, 0 );
+        if (av_dict_count( options ))
+        {
+            ERR( "FFmpeg left %d required HLS option(s) unused.\n", av_dict_count( options ) );
+            goto failed;
+        }
+        av_dict_free( &options );
+    }
+    else if (is_http_url( params->url ))
+    {
+        const char *protocol_whitelist;
+        BOOL interrupted;
+
+        TRACE( "media-route=direct-http-progressive\n" );
+        /* Progressive HTTP media should start as FFmpeg receives bytes instead
+         * of waiting for URLMon to cache the complete response.  Keep the
+         * protocol surface deliberately narrower than the configured FFmpeg
+         * build.  Plain HTTP may upgrade to verified HTTPS, while HTTPS cannot
+         * downgrade to plaintext. */
+        protocol_whitelist = http_protocol_whitelist( params->url );
+        if (av_dict_set( &options, "protocol_whitelist", protocol_whitelist, 0 ) < 0) goto failed;
+        if (av_dict_set_int( &options, "tls_verify", 1, 0 ) < 0) goto failed;
+
+        demuxer->direct_url = TRUE;
+        demuxer->require_avio_seek = TRUE;
+        demuxer->io_timeout = HTTP_IO_TIMEOUT_US;
+        demuxer->ctx->interrupt_callback.callback = demuxer_interrupt_callback;
+        demuxer->ctx->interrupt_callback.opaque = demuxer;
+        demuxer_set_deadline( demuxer, HTTP_OPEN_TIMEOUT_US );
+        ret = avformat_open_input( &demuxer->ctx, params->url, NULL, &options );
+        interrupted = demuxer_interrupt_callback( demuxer );
+        demuxer_set_deadline( demuxer, 0 );
+        if (ret < 0)
+        {
+            /* A timeout or cancellation must stay terminal.  Falling back to
+             * uncancellable URLMon after an interrupt would defeat the bound. */
+            if (!interrupted && http_open_allows_urlmon_fallback( params->url, ret ))
+                failure_status = STATUS_BAD_NETWORK_PATH;
+            WARN( "Failed to open progressive HTTP URL directly, error %s.\n", debugstr_averr(ret) );
+            goto failed;
+        }
+        TRACE( "media-route=direct-http-progressive-opened\n" );
+        /* The HTTP protocol keeps chained options for redirects and range
+         * reopens.  A plaintext-only request leaves tls_verify in this outer
+         * dictionary even though a later HTTPS hop still consumes it. */
+        av_dict_set( &options, "tls_verify", NULL, 0 );
+        if (av_dict_count( options ))
+        {
+            ERR( "FFmpeg left %d required HTTP option(s) unused.\n", av_dict_count( options ) );
+            goto failed;
+        }
+        av_dict_free( &options );
     }
     else if ((rtsp_kind = get_rtsp_url_kind( params->url )))
     {
@@ -956,7 +1057,7 @@ NTSTATUS demuxer_create( void *arg )
