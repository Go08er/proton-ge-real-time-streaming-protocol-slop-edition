+static BOOL is_http_url(const WCHAR *url)
+{
+    return url && (!wcsnicmp(url, L"http://", 7) || !wcsnicmp(url, L"https://", 8));
+}
+
 static BOOL is_http_hls_url(const WCHAR *url)
 {
     const WCHAR *cursor;
 
-    if (!url || (wcsnicmp(url, L"http://", 7) && wcsnicmp(url, L"https://", 8)))
+    if (!is_http_url(url))
         return FALSE;
 
-    for (cursor = url; *cursor; cursor++)
+    cursor = url + (!wcsnicmp(url, L"http://", 7) ? 7 : 8);
+    while (*cursor && *cursor != '/' && *cursor != '?' && *cursor != '#')
+        cursor++;
+    if (*cursor != '/')
+        return FALSE;
+
+    for (; *cursor && *cursor != '?' && *cursor != '#'; cursor++)
         if (!wcsnicmp(cursor, L".m3u8", 5) || !wcsnicmp(cursor, L"/hls_playlist/", 14))
             return TRUE;
 
     return FALSE;
 }
 
