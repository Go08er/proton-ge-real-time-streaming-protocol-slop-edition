+static int demuxer_interrupt_callback( void *opaque )
+{
+    struct demuxer *demuxer = opaque;
+    INT64 deadline;
+
+    if (__atomic_load_n( &demuxer->cancelled, __ATOMIC_ACQUIRE )) return 1;
+    deadline = __atomic_load_n( &demuxer->deadline, __ATOMIC_RELAXED );
+    return deadline && av_gettime_relative() >= deadline;
+}
+
+static void demuxer_set_deadline( struct demuxer *demuxer, INT64 timeout )
+{
+    INT64 deadline = timeout ? av_gettime_relative() + timeout : 0;
+    __atomic_store_n( &demuxer->deadline, deadline, __ATOMIC_RELAXED );
+}
+
+static BOOL demuxer_is_seekable( const struct demuxer *demuxer )
+{
+    if (demuxer->ctx->ctx_flags & AVFMTCTX_UNSEEKABLE) return FALSE;
+    if (!demuxer->direct_url && demuxer->ctx->pb &&
+        !(demuxer->ctx->pb->seekable & AVIO_SEEKABLE_NORMAL)) return FALSE;
+    return TRUE;
+}
