+    __atomic_store_n( &demuxer->cancelled, !!params->cancelled, __ATOMIC_RELEASE );
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS demuxer_get_flags( void *arg )
+{
+    struct demuxer_get_flags_params *params = arg;
+    struct demuxer *demuxer = get_demuxer( params->demuxer );
