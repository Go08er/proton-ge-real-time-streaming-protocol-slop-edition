+    if (!demuxer || !demuxer->ctx) return STATUS_INVALID_HANDLE;
+    params->flags = demuxer_is_seekable( demuxer ) ? WINEDMO_DEMUXER_FLAG_SEEKABLE : 0;
+    return STATUS_SUCCESS;
