+NTSTATUS CDECL winedmo_demuxer_set_cancelled( struct winedmo_demuxer demuxer, BOOL cancelled )
+{
+    struct demuxer_set_cancelled_params params = {.demuxer = demuxer, .cancelled = !!cancelled};
+    NTSTATUS status;
+
+    if (!demuxer.handle) return STATUS_SUCCESS;
+    if ((status = UNIX_CALL( demuxer_set_cancelled, &params )))
+        WARN( "demuxer_set_cancelled failed, status %#lx\n", status );
+    return status;
+}
+
+NTSTATUS CDECL winedmo_demuxer_get_flags( struct winedmo_demuxer demuxer, UINT32 *flags )
+{
+    struct demuxer_get_flags_params params = {.demuxer = demuxer};
+    NTSTATUS status;
+
+    if (!flags) return STATUS_INVALID_PARAMETER;
+    *flags = 0;
+    if (!demuxer.handle) return STATUS_INVALID_HANDLE;
+    if ((status = UNIX_CALL( demuxer_get_flags, &params )))
+        WARN( "demuxer_get_flags failed, status %#lx\n", status );
+    else
+        *flags = params.flags;
+    return status;
+}
+
