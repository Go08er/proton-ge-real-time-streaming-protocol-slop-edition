From 7f5c8f1f408c49d8b73086a0f70c762709acb8d8 Mon Sep 17 00:00:00 2001
From: RTSP-on-GE design <rtsp-on-ge@example.invalid>
Date: Wed, 22 Jul 2026 19:30:00 -0500
Subject: [PATCH] mf: synchronize the clock for replacement sinks

An immediate topology replacement can leave the MediaSession state and its
presentation clock started while all nodes in the new presentation are still
stopped. The fresh-start routing must stop the physical clock, not only clear
the session's clock_started marker.

Otherwise SetPresentationClock() attaches the new sinks to a running clock.
Their asynchronous Started notifications can overtake preroll, leaving the
session permanently in COMMAND_STATE_PREROLLING_SINKS even though samples and
time advance. Stop the old clock before the replacement sources start and
before any new sink is attached. Also detach outgoing sinks when their
presentation is cleared; keeping them registered would restart obsolete
renderers when the synchronized clock starts the replacement.

Attaching a new sink to the stopped clock asynchronously reports that current
Stop state. Track that single synchronization notification per output node and
consume it without regressing a node that has already prerolled. Clear the
expectation defensively when the stream starts. A real later session Stop is
therefore still processed normally.
---
 dlls/mf/session.c | 41 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/dlls/mf/session.c b/dlls/mf/session.c
--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -191,6 +191,7 @@ enum topo_node_flags
     TOPO_NODE_SCRUB_SAMPLE_COMPLETE = 0x2,
     TOPO_NODE_MARKIN_HERE = 0x4,
     TOPO_NODE_TRANSFORM_NEEDS_INPUT = 0x8,
+    TOPO_NODE_EXPECT_INITIAL_CLOCK_STOP = 0x10,
 };
 
 enum pcm_probe_kind
@@ -970,6 +971,7 @@ static void session_clear_presentation(struct media_session *session)
     struct media_source *source, *source2;
     struct media_sink *sink, *sink2;
     struct topo_node *node, *node2;
+    HRESULT hr;
 
     IMFTopology_Clear(session->presentation.current_topology);
     session->presentation.topo_status = MF_TOPOSTATUS_INVALID;
@@ -992,7 +994,11 @@ static void session_clear_presentation(struct media_session *session)
         list_remove(&sink->entry);
 
         if (sink->sink)
+        {
+            if (FAILED(hr = IMFMediaSink_SetPresentationClock(sink->sink, NULL)))
+                WARN("Failed to detach presentation clock from sink %p, hr %#lx.\n", sink->sink, hr);
             IMFMediaSink_Release(sink->sink);
+        }
         if (sink->preroll)
             IMFMediaSinkPreroll_Release(sink->preroll);
         if (sink->event_generator)
@@ -1197,6 +1203,7 @@ static void session_start(struct media_session *session, const GUID *time_format
     struct media_source *source;
     struct topo_node *topo_node;
     BOOL keep_position, sources_stopped;
+    MFCLOCK_STATE clock_state;
     MFTIME duration;
     HRESULT hr;
     UINT i;
@@ -1219,6 +1226,27 @@ static void session_start(struct media_session *session, const GUID *time_format
             if (sources_stopped)
             {
                 /* An immediate replacement is a fresh, not a running, presentation. */
+                if (FAILED(hr = IMFPresentationClock_GetState(session->clock, 0, &clock_state)))
+                {
+                    WARN("Failed to get replacement presentation clock state %p, hr %#lx.\n", session, hr);
+                    session_command_complete_with_event(session, MESessionStarted, hr, NULL);
+                    return;
+                }
+                if (clock_state != MFCLOCK_STATE_INVALID)
+                {
+                    if (clock_state != MFCLOCK_STATE_STOPPED &&
+                            FAILED(hr = IMFPresentationClock_Stop(session->clock)))
+                    {
+                        WARN("Failed to stop replacement presentation clock %p, hr %#lx.\n", session, hr);
+                        session_command_complete_with_event(session, MESessionStarted, hr, NULL);
+                        return;
+                    }
+                    LIST_FOR_EACH_ENTRY(topo_node, &session->presentation.nodes, struct topo_node, entry)
+                    {
+                        if (topo_node->type == MF_TOPOLOGY_OUTPUT_NODE)
+                            topo_node->flags |= TOPO_NODE_EXPECT_INITIAL_CLOCK_STOP;
+                    }
+                }
                 session->state = SESSION_STATE_STOPPED;
                 session->clock_started = FALSE;
             }
@@ -3522,10 +3550,24 @@ static void session_set_sink_stream_state(struct media_session *session, IMFStre
         MediaEventType event_type)
 {
     struct media_source *source;
+    struct topo_node *node;
     enum object_state state;
     HRESULT hr = S_OK;
     BOOL changed;
 
+    if ((node = session_get_node_object(session, (IUnknown *)stream, MF_TOPOLOGY_OUTPUT_NODE)) &&
+            node->flags & TOPO_NODE_EXPECT_INITIAL_CLOCK_STOP)
+    {
+        if (event_type == MEStreamSinkStopped)
+        {
+            node->flags &= ~TOPO_NODE_EXPECT_INITIAL_CLOCK_STOP;
+            TRACE("Ignoring initial sink Stop for replacement session %p.\n", session);
+            return;
+        }
+        if (event_type == MEStreamSinkStarted)
+            node->flags &= ~TOPO_NODE_EXPECT_INITIAL_CLOCK_STOP;
+    }
+
     if ((state = session_get_object_state_for_event(event_type)) == OBJ_STATE_INVALID)
         return;
 
-- 
