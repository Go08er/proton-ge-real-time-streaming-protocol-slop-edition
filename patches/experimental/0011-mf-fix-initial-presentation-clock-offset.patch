From c1f40112915a6e58f631e0ef15a926c97a42710f Mon Sep 17 00:00:00 2001
From: Torge Matthies <openglfreak@googlemail.com>
Date: Fri, 17 Jan 2025 13:11:49 +0100
Subject: [PATCH 10/11] mf: fix presentation clock starting at wrong offset

If the presentation clock is first started using Pause and then unpaused at
PRESENTATION_CURRENT_POSITION, it can start with the current system time as
its offset.

Track whether the session clock has actually started.  Normalize an undefined
"current position" on its first start to zero, and do not let a buffering-stop
event start a clock that has never run.  This is a context-adjusted port of
RTSP Wine commit c1f40112915a6e58f631e0ef15a926c97a42710f; the GE base does
not yet contain the adjacent RTSP buffering-state patch.
---
 dlls/mf/session.c | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/dlls/mf/session.c b/dlls/mf/session.c
index df8548e..175d143 100644
--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -289,6 +289,7 @@ struct media_session
     enum session_state state;
     enum command_state command_state;
     DWORD caps;
+    BOOL clock_started;
     CRITICAL_SECTION cs;
 };
 
@@ -1382,7 +1383,10 @@ static void session_stop(struct media_session *session)
             /* Transition in two steps - stop the clock, wait for sinks, then stop sources. */
             IMFPresentationClock_GetTime(session->clock, &session->presentation.clock_stop_time);
             if (SUCCEEDED(hr = IMFPresentationClock_Stop(session->clock)))
+            {
+                session->clock_started = FALSE;
                 session->command_state = COMMAND_STATE_STOPPING_SINKS;
+            }
             else
                 session_set_stopped(session, MESessionStopped, hr);
 
@@ -1439,7 +1443,10 @@ static void session_close(struct media_session *session)
         case SESSION_STATE_STARTED:
         case SESSION_STATE_PAUSED:
             if (SUCCEEDED(hr = IMFPresentationClock_Stop(session->clock)))
+            {
+                session->clock_started = FALSE;
                 session->command_state = COMMAND_STATE_CLOSING_SINKS;
+            }
             break;
         case SESSION_STATE_CLOSED:
         case SESSION_STATE_SHUT_DOWN:
@@ -3195,6 +3202,7 @@ static enum object_state session_get_object_state_for_event(MediaEventType event
 static HRESULT session_start_clock(struct media_session *session)
 {
     LONGLONG start_offset = 0;
+    MFCLOCK_STATE state;
     HRESULT hr;
 
     if (IsEqualGUID(&session->presentation.time_format, &GUID_NULL))
@@ -3209,8 +3217,19 @@ static HRESULT session_start_clock(struct media_session *session)
     else
         FIXME("Unhandled time format %s.\n", debugstr_guid(&session->presentation.time_format));
 
+    if (start_offset == PRESENTATION_CURRENT_POSITION && !session->clock_started)
+    {
+        if (SUCCEEDED(IMFPresentationClock_GetState(session->clock, 0, &state)) &&
+                state != MFCLOCK_STATE_INVALID && state != MFCLOCK_STATE_STOPPED &&
+                SUCCEEDED(IMFPresentationClock_Stop(session->clock)))
+            session->clock_started = FALSE;
+        start_offset = 0;
+    }
+
     if (FAILED(hr = IMFPresentationClock_Start(session->clock, start_offset)))
         WARN("Failed to start session clock, hr %#lx.\n", hr);
+    else
+        session->clock_started = TRUE;
 
     return hr;
 }
@@ -4614,7 +4631,7 @@ static HRESULT WINAPI session_events_callback_Invoke(IMFAsyncCallback *iface, IM
             {
                 if (event_type == MEBufferingStarted)
                     IMFPresentationClock_Pause(session->clock);
-                else
+                else if (session->clock_started)
                     IMFPresentationClock_Start(session->clock, PRESENTATION_CURRENT_POSITION);
 
                 IMFMediaEventQueue_QueueEvent(session->event_queue, event);
