+static HRESULT WINAPI media_engine_deferred_seek_callback_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
+{
+    struct media_engine *engine = impl_from_deferred_seek_callback_IMFAsyncCallback(iface);
+    DWORD elapsed;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&engine->cs);
+    engine->deferred_seek_work_scheduled = FALSE;
+
+    if (!(engine->flags & FLAGS_ENGINE_SHUT_DOWN) && (engine->flags & FLAGS_ENGINE_DEFERRED_SEEK))
+    {
+        elapsed = GetTickCount() - engine->deferred_seek_time;
+        if (elapsed < 250)
+            hr = media_engine_schedule_deferred_seek(engine, 250 - elapsed);
+        else
+            hr = media_engine_flush_deferred_seek(engine);
+
+        if (FAILED(hr))
+            WARN("Failed to flush deferred seek, hr %#lx.\n", hr);
+    }
+
+    LeaveCriticalSection(&engine->cs);
+    return S_OK;
+}
