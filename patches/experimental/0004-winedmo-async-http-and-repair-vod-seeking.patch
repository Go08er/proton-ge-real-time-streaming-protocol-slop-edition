+static ULONG WINAPI media_engine_deferred_seek_callback_AddRef(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_deferred_seek_callback_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_AddRef(&engine->IMFMediaEngineEx_iface);
+}
+
+static ULONG WINAPI media_engine_deferred_seek_callback_Release(IMFAsyncCallback *iface)
+{
+    struct media_engine *engine = impl_from_deferred_seek_callback_IMFAsyncCallback(iface);
+    return IMFMediaEngineEx_Release(&engine->IMFMediaEngineEx_iface);
+}
