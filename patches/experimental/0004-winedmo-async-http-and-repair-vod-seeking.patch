+static void media_engine_discard_source_object(IUnknown *object)
+{
+    IMFMediaSource *source;
+    HRESULT hr;
+
+    if (!object)
+        return;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(object, &IID_IMFMediaSource, (void **)&source)))
+    {
+        if (FAILED(hr = IMFMediaSource_Shutdown(source)))
+            WARN("Failed to shut down discarded media source, hr %#lx.\n", hr);
+        IMFMediaSource_Release(source);
+    }
+    IUnknown_Release(object);
+}
