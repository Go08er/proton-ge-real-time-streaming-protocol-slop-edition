+static HRESULT media_engine_schedule_deferred_seek(struct media_engine *engine, DWORD delay)
+{
+    HRESULT hr;
+
+    if (engine->deferred_seek_work_scheduled)
+        return S_OK;
+
+    if (!delay)
+        delay = 1;
+    hr = MFScheduleWorkItem(&engine->deferred_seek_callback, NULL, -(INT64)delay, NULL);
+    if (SUCCEEDED(hr))
+        engine->deferred_seek_work_scheduled = TRUE;
+    else
+    {
+        WARN("Failed to schedule deferred seek, hr %#lx; flushing synchronously.\n", hr);
+        hr = media_engine_flush_deferred_seek(engine);
+    }
+
+    return hr;
+}
