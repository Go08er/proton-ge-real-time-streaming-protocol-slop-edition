+        }
+
         if (pkt)
         {
             hr = media_stream_send_sample(stream, pkt, *token);
@@ -1439,6 +1525,39 @@ static HRESULT wait_on_sample(struct media_stream *stream, IUnknown **token, LON
  * Demux thread
  * ======================================================================== */
 
+static BOOL media_source_queue_demux_error(struct media_source *source, HRESULT error)
+{
+    BOOL queued;
+    HRESULT hr;
+    UINT i;
+
+    EnterCriticalSection(&source->demux_error_cs);
+    if (!media_source_set_demux_error(source, error))
+    {
+        LeaveCriticalSection(&source->demux_error_cs);
+        return FALSE;
+    }
+
+    source->demux_thread_shutdown = true;
+    if (FAILED(hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue,
+            MEError, &GUID_NULL, error, NULL)))
+        WARN("Failed to queue demux error %#lx, hr %#lx.\n", error, hr);
+    else
+        InterlockedIncrement(&source->demux_error_event_generation);
+
+    for (i = 0; i < source->stream_count; ++i)
+    {
+        struct media_stream *stream = source->streams[i];
+
+        EnterCriticalSection(&stream->queue_cs);
+        WakeAllConditionVariable(&stream->queue_cv);
+        LeaveCriticalSection(&stream->queue_cs);
+    }
+    queued = SUCCEEDED(hr);
+    LeaveCriticalSection(&source->demux_error_cs);
+    return queued;
+}
+
 static DWORD CALLBACK source_demux_thread(void *arg)
 {
     struct media_source *source = arg;
@@ -1495,16 +1614,29 @@ static DWORD CALLBACK source_demux_thread(void *arg)
             continue;
         }
         status = winedmo_demuxer_read(source->demuxer, &stream_idx, &output, &needed_size);
-        LeaveCriticalSection(&source->demuxer_cs);
 
-        /* A complete seek may begin and end before this read returns.  The
-         * transition epoch detects that case even after flushing is clear. */
+        /* Claim a terminal network error while this lock still excludes a
+         * seek. A seek which began before this claim changes the transition
+         * epoch; demux_error_cs separately orders the claim against the final
+         * Started/Seeked event commit without covering a blocking read. */
         if (read_epoch != media_source_get_demux_transition(source)
                 || source->demux_thread_shutdown)
         {
+            LeaveCriticalSection(&source->demuxer_cs);
             IMediaBuffer_Release(&sbuf->IMediaBuffer_iface);
             continue;
         }
+        if (status == STATUS_CANCELLED || status == STATUS_IO_TIMEOUT
+                || status == STATUS_CONNECTION_DISCONNECTED)
+        {
+            HRESULT error = media_source_error_from_demux_status(status);
+
+            media_source_queue_demux_error(source, error);
+            LeaveCriticalSection(&source->demuxer_cs);
+            IMediaBuffer_Release(&sbuf->IMediaBuffer_iface);
+            break;
+        }
+        LeaveCriticalSection(&source->demuxer_cs);
 
         if (status == STATUS_BUFFER_TOO_SMALL)
         {
@@ -1637,6 +1769,9 @@ static HRESULT WINAPI source_async_commands_Invoke(IMFAsyncCallback *iface, IMFA
 
     EnterCriticalSection(&source->cs);
 
+    while (source->demux_seek_pending && source->state != SOURCE_SHUTDOWN)
+        SleepConditionVariableCS(&source->work_cv, &source->cs, INFINITE);
+
     command = impl_from_async_command_IUnknown(state);
     switch (command->op)
     {
@@ -1645,12 +1780,14 @@ static HRESULT WINAPI source_async_commands_Invoke(IMFAsyncCallback *iface, IMFA
             IMFPresentationDescriptor *descriptor = command->u.start.descriptor;
             GUID format = command->u.start.format;
             PROPVARIANT position = command->u.start.position;
+            BOOL error_queued;
 
-            if (FAILED(hr = media_source_start(source, descriptor, &format, &position)))
+            if (FAILED(hr = media_source_start(source, descriptor, &format, &position, &error_queued)))
             {
                 WARN("Failed to start source %p, hr %#lx\n", source, hr);
-                IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MEError,
-                        &GUID_NULL, hr, NULL);
+                if (!error_queued)
+                    IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MEError,
+                            &GUID_NULL, hr, NULL);
             }
             break;
         }
@@ -2263,6 +2400,8 @@ static ULONG WINAPI media_source_Release(IMFMediaSource *iface)
         IMFMediaSource_Shutdown(iface);
         IMFMediaEventQueue_Release(source->event_queue);
         IMFByteStream_Release(source->byte_stream);
+        source->demux_error_cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&source->demux_error_cs);
         source->demuxer_cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&source->demuxer_cs);
         source->cs.DebugInfo->Spare[0] = 0;
@@ -2608,6 +2747,8 @@ static HRESULT media_source_create(struct object_context *context, IMFMediaSourc
     object->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": cs");
     InitializeCriticalSectionEx(&object->demuxer_cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
     object->demuxer_cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": demuxer_cs");
+    InitializeCriticalSectionEx(&object->demux_error_cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    object->demux_error_cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": demux_error_cs");
     InitializeConditionVariable(&object->work_cv);
 
     if (FAILED(hr = MFCreateEventQueue(&object->event_queue)))
@@ -2744,6 +2885,8 @@ fail:
     if (object->event_queue)
         IMFMediaEventQueue_Release(object->event_queue);
     IMFByteStream_Release(object->byte_stream);
+    object->demux_error_cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection(&object->demux_error_cs);
     object->demuxer_cs.DebugInfo->Spare[0] = 0;
     DeleteCriticalSection(&object->demuxer_cs);
     object->cs.DebugInfo->Spare[0] = 0;
diff --git a/dlls/winedmo/unix_demuxer.c b/dlls/winedmo/unix_demuxer.c
