@@ -442,6 +445,27 @@ static LONG media_source_get_demux_transition(struct media_source *source)
     return InterlockedCompareExchange(&source->demux_transition_epoch, 0, 0);
 }
 
+static HRESULT media_source_error_from_demux_status(NTSTATUS status)
+{
+    if (status == STATUS_CANCELLED)
+        return MF_E_OPERATION_CANCELLED;
+    if (status == STATUS_IO_TIMEOUT)
+        return MF_E_NET_TIMEOUT;
+    if (status == STATUS_CONNECTION_DISCONNECTED)
+        return MF_E_NET_READ;
+    return HRESULT_FROM_NT(status);
+}
+
+static HRESULT media_source_get_demux_error(struct media_source *source)
+{
+    return InterlockedCompareExchange(&source->demux_terminal_error, S_OK, S_OK);
+}
+
+static BOOL media_source_set_demux_error(struct media_source *source, HRESULT error)
+{
+    return InterlockedCompareExchange(&source->demux_terminal_error, error, S_OK) == S_OK;
+}
+
 static inline struct media_source *impl_from_IMFGetService(IMFGetService *iface)
 {
     return CONTAINING_RECORD(iface, struct media_source, IMFGetService_iface);
@@ -1005,11 +1029,14 @@ static HRESULT media_stream_start(struct media_stream *stream, BOOL active, BOOL
             seeking ? MEStreamSeeked : MEStreamStarted, &GUID_NULL, S_OK, position);
 }
 
+static BOOL media_source_queue_demux_error(struct media_source *source, HRESULT error);
+
 static HRESULT media_source_start(struct media_source *source, IMFPresentationDescriptor *descriptor,
-        GUID *format, PROPVARIANT *position)
+        GUID *format, PROPVARIANT *position, BOOL *error_queued)
 {
     BOOL starting = source->state == SOURCE_STOPPED, seek_message;
     IMFStreamDescriptor **descriptors;
+    LONG error_event_generation;
     NTSTATUS status = STATUS_SUCCESS;
     DWORD i, count;
     HRESULT hr;
@@ -1017,10 +1044,13 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
     TRACE("source %p, descriptor %p, format %s, position %s\n", source, descriptor,
             debugstr_guid(format), wine_dbgstr_variant((VARIANT *)position));
 
+    *error_queued = FALSE;
     if (source->state == SOURCE_SHUTDOWN)
         return MF_E_SHUTDOWN;
-    if (FAILED(source->demux_terminal_error))
-        return source->demux_terminal_error;
+    if (FAILED(hr = media_source_get_demux_error(source)))
+        return hr;
+    error_event_generation = InterlockedCompareExchange(
+            &source->demux_error_event_generation, 0, 0);
 
     if (!source->seekable && position->vt != VT_EMPTY)
     {
@@ -1071,6 +1101,8 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
 
     if (position->vt == VT_I8)
     {
+        HRESULT seek_error = S_OK;
+
         /* Make every read from the old timeline distinguishable even if the
          * complete flush begins and ends before that read returns. */
         media_source_begin_demux_transition(source);
@@ -1095,18 +1127,48 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
         if (!(status = winedmo_demuxer_set_cancelled(source->demuxer, TRUE)))
         {
             EnterCriticalSection(&source->demuxer_cs);
-            if (!(status = winedmo_demuxer_set_cancelled(source->demuxer, FALSE)))
+            if (FAILED(seek_error = media_source_get_demux_error(source)))
+                status = STATUS_SUCCESS;
+            else if (!(status = winedmo_demuxer_set_cancelled(source->demuxer, FALSE)))
+            {
+                /* Let Shutdown acquire source->cs and trip the demuxer's
+                 * interrupt callback while a direct network seek is blocked.
+                 * The pending work-item count keeps this source alive, while
+                 * demux_seek_pending keeps other source commands serialized. */
+                source->demux_seek_pending = true;
+                LeaveCriticalSection(&source->cs);
                 status = winedmo_demuxer_seek(source->demuxer, position->hVal.QuadPart);
+                EnterCriticalSection(&source->cs);
+                source->demux_seek_pending = false;
+                WakeAllConditionVariable(&source->work_cv);
+                if (!status && (source->state == SOURCE_SHUTDOWN
+                        || source->demux_thread_shutdown))
+                    status = STATUS_CANCELLED;
+            }
             LeaveCriticalSection(&source->demuxer_cs);
         }
 
-        if (status)
+        if (FAILED(seek_error) || status)
         {
+            HRESULT error = FAILED(seek_error) ? seek_error
+                    : media_source_error_from_demux_status(status);
+
             /* Cancellation or seek failed after the old queues were flushed.
              * Keep the epoch odd and stop the producer rather than retrying an
              * unknown or damaged timeline. */
-            source->demux_thread_shutdown = true;
-            source->demux_terminal_error = HRESULT_FROM_NT(status);
+            if (error == MF_E_OPERATION_CANCELLED || error == MF_E_NET_TIMEOUT
+                    || error == MF_E_NET_READ)
+            {
+                *error_queued = media_source_queue_demux_error(source, error);
+                if (!*error_queued && error_event_generation != InterlockedCompareExchange(
+                        &source->demux_error_event_generation, 0, 0))
+                    *error_queued = TRUE;
+            }
+            else
+            {
+                source->demux_thread_shutdown = true;
+                media_source_set_demux_error(source, error);
+            }
             for (i = 0; i < source->stream_count; i++)
             {
                 struct media_stream *stream = source->streams[i];
@@ -1115,8 +1177,8 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
                 ++stream->request_generation;
                 stream->active = FALSE;
                 stream->paused = FALSE;
-                stream->eos = TRUE;
-                stream->eos_epoch = media_source_get_demux_transition(source);
+                stream->eos = FALSE;
+                stream->eos_epoch = 0;
                 WakeAllConditionVariable(&stream->queue_cv);
                 LeaveCriticalSection(&stream->queue_cs);
                 flush_token_queue(stream, FALSE);
@@ -1129,15 +1191,30 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
             media_source_end_demux_transition(source);
         }
 
-        if (status)
+        if (FAILED(seek_error) || status)
         {
             for (i = 0; i < source->stream_count; i++)
                 if (descriptors[i]) IMFStreamDescriptor_Release(descriptors[i]);
             free(descriptors);
-            return HRESULT_FROM_NT(status);
+            return media_source_get_demux_error(source);
         }
     }
 
+    /* Commit stream/source Started or Seeked events while terminal-error
+     * publication is excluded. This prevents an error claimed before commit
+     * from being followed by a stale successful source transition. */
+    EnterCriticalSection(&source->demux_error_cs);
+    if (FAILED(hr = media_source_get_demux_error(source)))
+    {
+        *error_queued = error_event_generation != InterlockedCompareExchange(
+                &source->demux_error_event_generation, 0, 0);
+        LeaveCriticalSection(&source->demux_error_cs);
+        for (i = 0; i < source->stream_count; i++)
+            if (descriptors[i]) IMFStreamDescriptor_Release(descriptors[i]);
+        free(descriptors);
+        return hr;
+    }
+
     for (i = 0; i < source->stream_count; i++)
     {
         struct media_stream *stream = source->streams[i];
@@ -1183,8 +1260,10 @@ static HRESULT media_source_start(struct media_source *source, IMFPresentationDe
     for (i = 0; i < source->stream_count; i++)
         flush_token_queue(source->streams[i], source->streams[i]->active);
 
-    return IMFMediaEventQueue_QueueEventParamVar(source->event_queue,
+    hr = IMFMediaEventQueue_QueueEventParamVar(source->event_queue,
             seek_message ? MESourceSeeked : MESourceStarted, &GUID_NULL, S_OK, position);
+    LeaveCriticalSection(&source->demux_error_cs);
+    return hr;
 }
 
 /* ========================================================================
@@ -1419,6 +1498,13 @@ static HRESULT wait_on_sample(struct media_stream *stream, IUnknown **token, LON
             return S_OK;
         }
 
+        if (FAILED(hr = media_source_get_demux_error(source)))
