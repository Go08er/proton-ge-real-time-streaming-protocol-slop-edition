From a06ad1f1d42596f40e8b617c984152face23d190 Mon Sep 17 00:00:00 2001
From: RTSP-on-GE design <rtsp-on-ge@example.invalid>
Date: Thu, 23 Jul 2026 18:38:25 -0500
Subject: [PATCH] winedmo: propagate terminal network read errors

Direct HTTP, HLS, and RTSP inputs currently turn terminal FFmpeg read failures into clean end-of-file. For progressive MP4, avformat_seek_file() also returns before the HTTP Range reopen, so a failed reopen is discovered only after Media Foundation has reported SEEKED.

Keep true EOF and legacy local-bytestream behavior unchanged. Classify terminal direct-network failures, prefetch one packet after progressive-HTTP seeks so deferred Range errors are causal, retain the first source error, wake blocked sample requests, and forward only the current source through MediaSession to MediaEngine ERROR. Clear terminal error state when a new source is selected.

A3.19: rebased after GE-Proton11-6's ge-video-rework set.
---
diff --git a/dlls/mf/session.c b/dlls/mf/session.c
index efce5a64b6cda8f20eab26e70bd63f03ca9bb8b9..ee027477236efb59145d44975315b31b6753b759 100644
--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -134,6 +134,7 @@ enum object_state
 enum media_source_flags
 {
     SOURCE_FLAG_END_OF_PRESENTATION = 0x1,
+    SOURCE_FLAG_TERMINAL_ERROR_FORWARDED = 0x2,
 };
 
 struct media_source
@@ -4869,13 +4870,44 @@ static HRESULT WINAPI session_events_callback_Invoke(IMFAsyncCallback *iface, IM
         }
 
         case MEError:
+        {
+            struct media_source *session_source;
+
             /* Wine-specific extension */
             EnterCriticalSection(&session->cs);
-            if (SUCCEEDED(IMFMediaEvent_GetStatus(event, &hr)) && hr == MF_E_SHUTDOWN &&
-                    session_get_media_source(session, (IMFMediaSource *)event_source))
-                session_handle_source_shutdown(session);
+            if (SUCCEEDED(IMFMediaEvent_GetStatus(event, &hr)) &&
+                    (session_source = session_get_media_source(session, (IMFMediaSource *)event_source)))
+            {
+                if (hr == MF_E_SHUTDOWN)
+                    session_handle_source_shutdown(session);
+                else if (hr == MF_E_OPERATION_CANCELLED || hr == MF_E_NET_TIMEOUT
+                        || hr == MF_E_NET_READ)
+                {
+                    if (!(session_source->flags & SOURCE_FLAG_TERMINAL_ERROR_FORWARDED))
+                    {
+                        HRESULT queue_hr;
+
+                        queue_hr = IMFMediaEventQueue_QueueEventParamUnk(session->event_queue,
+                                MEError, &GUID_NULL, hr, (IUnknown *)(IMFMediaSource *)event_source);
+                        if (FAILED(queue_hr))
+                            WARN("Failed to forward source error %#lx, hr %#lx.\n", hr, queue_hr);
+                        else
+                            session_source->flags |= SOURCE_FLAG_TERMINAL_ERROR_FORWARDED;
+                    }
+
+                    /* A terminal source error replaces the missing
+                     * MESourceStarted/Seeked completion. Finish the command
+                     * without synthesizing MESessionStarted, which MediaEngine
+                     * would otherwise mistake for a successful seek. */
+                    if (session->command_state == COMMAND_STATE_STARTING_SOURCES
+                            || session->command_state == COMMAND_STATE_PREROLLING_SINKS
+                            || session->command_state == COMMAND_STATE_STARTING_SINKS)
+                        session_command_complete(session);
+                }
+            }
             LeaveCriticalSection(&session->cs);
             break;
+        }
 
         default:
             ;
diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
index de93198fd40d11a3ad5b382623eca3e76002d854..81c8be1d9c8ed602421540853c56d6394aef429a 100644
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -205,6 +205,7 @@ struct media_engine
     BSTR current_source;
     struct
     {
+        UINT64 generation;
         IMFMediaSource *source;
         IMFPresentationDescriptor *pd;
         /* Pending MediaSession start state; always VT_EMPTY or VT_I8. */
@@ -1203,6 +1204,50 @@ static HRESULT WINAPI media_engine_session_events_Invoke(IMFAsyncCallback *iface
                 IMFMediaEngineNotify_EventNotify(engine->callback, MF_MEDIA_ENGINE_EVENT_ENDED, 0, 0);
             break;
 
+        case MEError:
+        {
+            MF_MEDIA_ENGINE_ERR error_code;
+            PROPVARIANT source = {.vt = VT_EMPTY};
+            HRESULT error;
+
+            if (FAILED(IMFMediaEvent_GetStatus(event, &error)) ||
+                    (error != MF_E_OPERATION_CANCELLED && error != MF_E_NET_TIMEOUT
+                    && error != MF_E_NET_READ) ||
+                    FAILED(IMFMediaEvent_GetValue(event, &source)) ||
+                    source.vt != VT_UNKNOWN || !source.punkVal)
+            {
+                PropVariantClear(&source);
+                break;
+            }
+
+            error_code = error == MF_E_OPERATION_CANCELLED
+                    ? MF_MEDIA_ENGINE_ERR_ABORTED : MF_MEDIA_ENGINE_ERR_NETWORK;
+            EnterCriticalSection(&engine->cs);
+            if ((engine->flags & FLAGS_ENGINE_SHUT_DOWN)
+                    || engine->presentation.generation != engine->source_generation
+                    || source.punkVal != (IUnknown *)engine->presentation.source)
+            {
+                LeaveCriticalSection(&engine->cs);
+                PropVariantClear(&source);
+                break;
+            }
+            engine->error_code = error_code;
+            engine->extended_code = error;
+            engine->playback_requested = FALSE;
+            engine->current_seek = NAN;
+            engine->next_seek = NAN;
+            engine->deferred_seek = NAN;
+            media_engine_set_flag(engine, FLAGS_ENGINE_SEEKING | FLAGS_ENGINE_DEFERRED_SEEK
+                    | FLAGS_ENGINE_PLAY_PENDING | FLAGS_ENGINE_PAUSE_PENDING
+                    | FLAGS_ENGINE_WAITING | FLAGS_ENGINE_SCRUBBING, FALSE);
+            IMFMediaEngineNotify_EventNotify(engine->callback, MF_MEDIA_ENGINE_EVENT_ERROR,
+                    error_code, error);
+            LeaveCriticalSection(&engine->cs);
+
+            PropVariantClear(&source);
+            break;
+        }
+
         case MEEndOfPresentation:
             EnterCriticalSection(&engine->cs);
             /* Media Engine users may wait on ended state before replacing the
@@ -1556,6 +1601,7 @@ static void media_engine_clear_presentation(struct media_engine *engine)
     /* Detach refcounted resources before dropping the lock.  A concurrent
      * source load may install a new presentation while Shutdown() drains its
      * callbacks; the old cleanup must never release or clear that new state. */
+    engine->presentation.generation = 0;
     engine->presentation.source = NULL;
     engine->presentation.pd = NULL;
     engine->presentation.frame_sink = NULL;
@@ -1675,6 +1721,7 @@ static HRESULT media_engine_create_topology(struct media_engine *engine, IMFMedi
         return MF_E_OPERATION_CANCELLED;
     }
 
+    engine->presentation.generation = generation;
     engine->presentation.source = source;
     IMFMediaSource_AddRef(engine->presentation.source);
     engine->presentation.pd = pd;
@@ -2146,6 +2193,8 @@ static HRESULT media_engine_set_source(struct media_engine *engine, IMFByteStrea
 
     generation = ++engine->source_generation;
 
+    engine->error_code = MF_MEDIA_ENGINE_ERR_NOERROR;
+    engine->extended_code = S_OK;
     SysFreeString(engine->current_source);
     engine->current_source = NULL;
     if (url)
diff --git a/dlls/winedmo/media_source.c b/dlls/winedmo/media_source.c
index b4bb72ae82f20575692dfbd505598018958f2c53..dc13d5f821c72088ba9a20380ff7af6d55396236 100644
--- a/dlls/winedmo/media_source.c
