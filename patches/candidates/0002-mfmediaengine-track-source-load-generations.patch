+static inline struct media_engine_load_context *impl_from_load_context_IUnknown(IUnknown *iface)
+{
+    return CONTAINING_RECORD(iface, struct media_engine_load_context, IUnknown_iface);
+}
+
+static HRESULT WINAPI media_engine_load_context_QueryInterface(IUnknown *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown))
+    {
+        *obj = iface;
+        IUnknown_AddRef(iface);
+        return S_OK;
+    }
+
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI media_engine_load_context_AddRef(IUnknown *iface)
+{
+    struct media_engine_load_context *context = impl_from_load_context_IUnknown(iface);
+    return InterlockedIncrement(&context->refcount);
+}
+
+static ULONG WINAPI media_engine_load_context_Release(IUnknown *iface)
+{
+    struct media_engine_load_context *context = impl_from_load_context_IUnknown(iface);
+    ULONG refcount = InterlockedDecrement(&context->refcount);
+
+    if (!refcount)
+    {
+        if (context->bytestream)
+            IMFByteStream_Release(context->bytestream);
+        free(context);
+    }
+
+    return refcount;
+}
+
+static const IUnknownVtbl media_engine_load_context_vtbl =
+{
+    media_engine_load_context_QueryInterface,
+    media_engine_load_context_AddRef,
+    media_engine_load_context_Release,
+};
+
+static HRESULT media_engine_load_context_create(enum media_engine_load_origin origin, UINT64 generation,
+        IMFByteStream *bytestream, struct media_engine_load_context **out)
+{
+    struct media_engine_load_context *context;
+
+    if (!(context = calloc(1, sizeof(*context))))
+        return E_OUTOFMEMORY;
+
+    context->IUnknown_iface.lpVtbl = &media_engine_load_context_vtbl;
+    context->refcount = 1;
+    context->origin = origin;
+    context->generation = generation;
+    context->bytestream = bytestream;
+    if (context->bytestream)
+        IMFByteStream_AddRef(context->bytestream);
+
+    *out = context;
+    return S_OK;
+}
+
+static HRESULT media_engine_end_source_load(struct media_engine *engine, struct media_engine_load_context *context,
+        IMFAsyncResult *result, IUnknown **object)
+{
+    MF_OBJECT_TYPE obj_type;
+
+    switch (context->origin)
+    {
+        case MEDIA_ENGINE_LOAD_EXTENSION:
+            return IMFMediaEngineExtension_EndCreateObject(engine->extension, result, object);
+        case MEDIA_ENGINE_LOAD_URL:
+            return IMFSourceResolver_EndCreateObjectFromURL(engine->resolver, result, &obj_type, object);
+        case MEDIA_ENGINE_LOAD_BYTESTREAM:
+            return IMFSourceResolver_EndCreateObjectFromByteStream(engine->resolver, result, &obj_type, object);
+        default:
+            return E_UNEXPECTED;
+    }
+}
+
+static void media_engine_discard_source_object(IUnknown *object)
+{
+    IMFMediaSource *source;
+    HRESULT hr;
+
+    if (!object)
+        return;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(object, &IID_IMFMediaSource, (void **)&source)))
+    {
+        if (FAILED(hr = IMFMediaSource_Shutdown(source)))
+            WARN("Failed to shut down discarded media source, hr %#lx.\n", hr);
+        IMFMediaSource_Release(source);
+    }
+    IUnknown_Release(object);
+}
