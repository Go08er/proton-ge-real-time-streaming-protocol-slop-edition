     return need_more_input;
 }
 
+static BOOL inspect_pcm_probe_sample(struct topo_node *node, BOOL output, UINT stream_index,
+        IMFSample *sample, struct pcm_probe_summary *summary)
+{
+    DWORD buffer_count = 0, length = 0, total_values = 0, inspected_values = 0;
+    DWORD total_frames = 0, inspected_frames = 0;
+    DWORD nonzero = 0, nonfinite = 0, i, stream_id;
+    const char *kind, *format = "unsupported", *inspection_status = "failed";
+    UINT32 bits = 0, channels = 0, sample_rate = 0;
+    double sum_square = 0.0, peak = 0.0, mean_square = 0.0;
+    IMFMediaType *media_type = NULL;
+    IMFMediaBuffer *buffer = NULL;
+    LONGLONG pts = 0, duration = 0;
+    BOOL have_pts, have_duration;
+    GUID subtype = {0};
+    BYTE *data = NULL;
+    BOOL locked = FALSE, truncated = FALSE;
+    DWORD scalar_size = 0;
+    HRESULT inspection_hr = E_FAIL;
+
+    if (!TRACE_ON(pcmprobe) || node->pcm_probe_kind == PCM_PROBE_NONE ||
+            node->pcm_probe_count >= PCM_PROBE_SAMPLE_LIMIT)
+        return FALSE;
+    if ((node->pcm_probe_kind == PCM_PROBE_AAC_DECODER && !output) ||
+            (node->pcm_probe_kind == PCM_PROBE_MEDIA_ENGINE_EFFECT && output))
+        return FALSE;
+
+    memset(summary, 0, sizeof(*summary));
+    summary->sequence = node->pcm_probe_count++;
+    kind = output ? "aac_decoder_output" : "media_engine_audio_effect_input";
+    have_pts = SUCCEEDED(IMFSample_GetSampleTime(sample, &pts));
+    have_duration = SUCCEEDED(IMFSample_GetSampleDuration(sample, &duration));
+    stream_id = transform_node_get_stream_id(node, output, stream_index);
+
+    if (output)
+        inspection_hr = IMFTransform_GetOutputCurrentType(node->object.transform, stream_id, &media_type);
+    else
+        inspection_hr = IMFTransform_GetInputCurrentType(node->object.transform, stream_id, &media_type);
+    if (FAILED(inspection_hr))
+        goto done;
+
+    IMFMediaType_GetGUID(media_type, &MF_MT_SUBTYPE, &subtype);
+    IMFMediaType_GetUINT32(media_type, &MF_MT_AUDIO_BITS_PER_SAMPLE, &bits);
+    IMFMediaType_GetUINT32(media_type, &MF_MT_AUDIO_NUM_CHANNELS, &channels);
+    IMFMediaType_GetUINT32(media_type, &MF_MT_AUDIO_SAMPLES_PER_SECOND, &sample_rate);
+
+    if (IsEqualGUID(&subtype, &MFAudioFormat_Float) && bits == 32)
+    {
+        format = "f32";
+        scalar_size = sizeof(float);
+    }
+    else if (IsEqualGUID(&subtype, &MFAudioFormat_PCM) && bits == 16)
+    {
+        format = "s16";
+        scalar_size = sizeof(INT16);
+    }
+    else
+    {
+        inspection_status = "unsupported";
+        inspection_hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+
+    if (FAILED(inspection_hr = IMFSample_GetBufferCount(sample, &buffer_count)))
+        goto done;
+    if (buffer_count != 1)
+    {
+        inspection_status = "unsupported_buffers";
+        inspection_hr = E_NOTIMPL;
+        goto done;
+    }
+    if (FAILED(inspection_hr = IMFSample_GetBufferByIndex(sample, 0, &buffer)))
+        goto done;
+    if (FAILED(inspection_hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &length)))
+        goto done;
+    locked = TRUE;
+
+    if (!channels || !sample_rate || length % scalar_size)
+    {
+        inspection_status = "invalid";
+        inspection_hr = MF_E_INVALIDMEDIATYPE;
+        goto done;
+    }
+
+    total_values = length / scalar_size;
+    inspected_values = min(total_values, PCM_PROBE_VALUE_LIMIT);
+    truncated = inspected_values != total_values;
+    inspection_status = inspected_values == total_values ? "complete" : "truncated";
+    inspection_hr = S_OK;
+
+    if (format[0] == 'f')
+    {
+        for (i = 0; i < inspected_values; ++i)
+        {
+            double magnitude;
+            float value;
+
+            memcpy(&value, data + i * sizeof(value), sizeof(value));
+            if (!isfinite(value))
+            {
+                ++nonfinite;
+                continue;
+            }
+
+            magnitude = value;
+            if (magnitude < 0.0)
+                magnitude = -magnitude;
+            if (magnitude != 0.0)
+                ++nonzero;
+            if (magnitude > peak)
+                peak = magnitude;
+            sum_square += magnitude * magnitude;
+        }
+    }
+    else if (format[0] == 's')
+    {
+        for (i = 0; i < inspected_values; ++i)
+        {
+            double magnitude;
+            INT16 value;
+
+            memcpy(&value, data + i * sizeof(value), sizeof(value));
+            magnitude = (double)value / 32768.0;
+            if (magnitude < 0.0)
+                magnitude = -magnitude;
+            if (magnitude != 0.0)
+                ++nonzero;
+            if (magnitude > peak)
+                peak = magnitude;
+            sum_square += magnitude * magnitude;
+        }
+    }
+
+done:
+    if (locked)
+        IMFMediaBuffer_Unlock(buffer);
+    if (buffer)
+        IMFMediaBuffer_Release(buffer);
+    if (media_type)
+        IMFMediaType_Release(media_type);
+
+    if (inspected_values > nonfinite)
+        mean_square = sum_square / (inspected_values - nonfinite);
+    if (channels)
+    {
+        total_frames = total_values / channels;
+        inspected_frames = inspected_values / channels;
+    }
+
+    summary->kind = kind;
+    summary->format = format;
+    summary->inspection_status = inspection_status;
+    summary->session = &node->session->IMFMediaSession_iface;
+    summary->node_id = node->node_id;
+    summary->stream_index = stream_index;
+    summary->inspection_hr = inspection_hr;
+    summary->bits = bits;
+    summary->channels = channels;
+    summary->sample_rate = sample_rate;
+    summary->buffer_count = buffer_count;
+    summary->length = length;
+    summary->have_pts = have_pts;
+    summary->pts = pts;
+    summary->have_duration = have_duration;
+    summary->duration = duration;
+    summary->total_values = total_values;
+    summary->inspected_values = inspected_values;
+    summary->total_frames = total_frames;
+    summary->inspected_frames = inspected_frames;
+    summary->truncated = truncated;
+    summary->nonzero = nonzero;
+    summary->peak = peak;
+    summary->mean_square = mean_square;
+    summary->nonfinite = nonfinite;
+
+    return TRUE;
+}
+
+static void trace_pcm_probe_summary(const struct pcm_probe_summary *summary, BOOL process_valid,
+        HRESULT process_hr, BOOL queue_attempted, HRESULT queue_hr,
+        BOOL delivery_valid, HRESULT delivery_hr)
+{
+    TRACE_(pcmprobe)("kind %s, session %p, node %s, seq %u, stream %u, status %s, hr %#lx, "
+            "format %s/%u, channels %u, rate %u, "
+            "buffers %lu, bytes %lu, pts_valid %d, pts %s, duration_valid %d, duration %s, "
+            "total_values %lu, inspected_values %lu, total_frames %lu, inspected_frames %lu, "
+            "truncated %d, nonzero %lu, peak %.9g, mean_square %.9g, nonfinite %lu, "
+            "process_valid %d, process_hr %#lx, queue_attempted %d, queue_hr %#lx, "
+            "delivery_valid %d, delivery_hr %#lx, accepted %d, queued %d.\n",
+            summary->kind, summary->session,
+            wine_dbgstr_longlong(summary->node_id), summary->sequence, summary->stream_index,
+            summary->inspection_status, summary->inspection_hr,
+            summary->format, summary->bits, summary->channels, summary->sample_rate,
+            summary->buffer_count, summary->length, summary->have_pts,
+            wine_dbgstr_longlong(summary->pts), summary->have_duration,
+            wine_dbgstr_longlong(summary->duration), summary->total_values,
+            summary->inspected_values, summary->total_frames, summary->inspected_frames,
+            summary->truncated, summary->nonzero, summary->peak, summary->mean_square,
+            summary->nonfinite, process_valid, process_hr, queue_attempted, queue_hr,
+            delivery_valid, delivery_hr, process_valid && SUCCEEDED(process_hr),
+            queue_attempted && SUCCEEDED(queue_hr));
+}
+
 static HRESULT transform_node_pull_samples(const struct media_session *session, struct topo_node *node)
 {
     MFT_OUTPUT_DATA_BUFFER *buffers;
@@ -3866,6 +4132,21 @@ static HRESULT transform_node_pull_samples(const struct media_session *session,
 
             hr = IMFTransform_ProcessOutput(node->object.transform, 0, node->u.transform.output_count, buffers, &status);
         }
+
+        if (TRACE_ON(pcmprobe) && hr == S_OK && node->pcm_probe_kind == PCM_PROBE_AAC_DECODER)
+        {
+            for (i = 0; i < node->u.transform.output_count; ++i)
+            {
+                struct pcm_probe_summary summary;
+
+                if (buffers[i].pSample && !(buffers[i].dwStatus & MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE))
+                {
+                    if (inspect_pcm_probe_sample(node, TRUE, i, buffers[i].pSample, &summary))
+                        trace_pcm_probe_summary(&summary, FALSE, E_NOTIMPL, FALSE, E_NOTIMPL,
+                                FALSE, E_NOTIMPL);
+                }
+            }
+        }
     }
     while (hr == S_OK && transform_node_markin_need_more_input(session, node, buffers));
 
@@ -3936,15 +4217,31 @@ static HRESULT transform_node_push_sample(const struct media_session *session, s
     struct transform_stream *stream = &topo_node->u.transform.inputs[input];
     UINT id = transform_node_get_stream_id(topo_node, FALSE, input);
     IMFTransform *transform = topo_node->object.transform;
+    BOOL probe_inspected = FALSE, queue_attempted = FALSE;
+    struct pcm_probe_summary probe_summary;
+    HRESULT queue_hr = E_NOTIMPL;
+    HRESULT process_hr;
     HRESULT hr;
 
     if (sample)
     {
-        hr = IMFTransform_ProcessInput(transform, id, sample, 0);
-        if (SUCCEEDED(hr))
+        if (TRACE_ON(pcmprobe) && topo_node->pcm_probe_kind == PCM_PROBE_MEDIA_ENGINE_EFFECT)
+            probe_inspected = inspect_pcm_probe_sample(topo_node, FALSE, input, sample, &probe_summary);
+
+        process_hr = IMFTransform_ProcessInput(transform, id, sample, 0);
+        hr = process_hr;
+        if (SUCCEEDED(process_hr))
             topo_node->flags &= ~TOPO_NODE_TRANSFORM_NEEDS_INPUT;
-        if (hr == MF_E_NOTACCEPTING)
-            hr = transform_stream_push_sample(stream, sample);
+        if (process_hr == MF_E_NOTACCEPTING)
+        {
+            queue_attempted = TRUE;
+            queue_hr = transform_stream_push_sample(stream, sample);
+            hr = queue_hr;
+        }
+
+        if (probe_inspected)
+            trace_pcm_probe_summary(&probe_summary, TRUE, process_hr, queue_attempted, queue_hr,
+                    TRUE, hr);
     }
     else
     {
