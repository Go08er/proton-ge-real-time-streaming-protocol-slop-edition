{
  "adapterSha256": "@ADAPTER_SHA256@",
  "autoAdvance": true,
  "bind": "127.0.0.1",
  "caseId": "hls-live-muxed-healthy",
  "controlToken": "host-live-control-token",
  "faultMode": "normal",
  "initialGeneration": 0,
  "maxConcurrent": 8,
  "maxErrorResponses": 0,
  "maxLogBytes": 4194304,
  "maxRequests": 512,
  "maxStartupMs": 10000,
  "minMuxPlaylistGenerations": 3,
  "minMuxPlaylistRequests": 3,
  "minMuxSegmentRequests": 6,
  "minPlaybackSpan": 5.0,
  "port": @PORT@,
  "publisherSha256": "@PUBLISHER_SHA256@",
  "requiredInstrumentation": "@INSTRUMENTATION@",
  "schema": 1,
  "service": "live-hls-v1",
  "source": "mux"
}
