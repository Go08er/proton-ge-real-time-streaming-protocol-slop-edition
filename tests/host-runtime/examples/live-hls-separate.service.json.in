{
  "adapterSha256": "@ADAPTER_SHA256@",
  "autoAdvance": true,
  "bind": "127.0.0.1",
  "caseId": "hls-live-separate-healthy",
  "controlToken": "host-live-control-token",
  "faultMode": "normal",
  "initialGeneration": 0,
  "maxConcurrent": 8,
  "maxErrorResponses": 0,
  "maxLogBytes": 4194304,
  "maxRequests": 512,
  "maxStartupMs": 10000,
  "minAudioPlaylistRequests": 3,
  "minAudioSegmentRequests": 3,
  "minMasterRequests": 1,
  "minPairedPlaylistGenerations": 3,
  "minPlaybackSpan": 5.0,
  "minVideoPlaylistRequests": 3,
  "minVideoSegmentRequests": 3,
  "port": @PORT@,
  "publisherSha256": "@PUBLISHER_SHA256@",
  "requiredInstrumentation": "@INSTRUMENTATION@",
  "schema": 1,
  "service": "live-hls-v1",
  "source": "separate"
}
