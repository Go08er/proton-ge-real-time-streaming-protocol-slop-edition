# SPDX-License-Identifier: BSD-3-Clause
# Establish decoded A/V, stop reading server traffic for one bounded interval,
# then require the same source generation to resume and advance.
load "rtsp://127.0.0.1:18554/fixture"
wait_event CANPLAY 20000
play
wait_event PLAYING 10000
wait_ms 1000
snapshot "rtsp-hold-precondition"
wait_ms 6000
loop 4
wait_ms 1000
snapshot "rtsp-live-g1"
endloop
shutdown
