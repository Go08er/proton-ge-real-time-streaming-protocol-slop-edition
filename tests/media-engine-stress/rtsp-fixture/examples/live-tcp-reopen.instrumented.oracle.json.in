{
  "audio_check_labels": [
    "rtsp-live-g1",
    "rtsp-live-g2",
    "rtsp-live-g3"
  ],
  "checkpoint_expectations": [
    {
      "action": "snapshot",
      "ended": false,
      "has_audio": true,
      "has_video": true,
      "label": "rtsp-live-g1",
      "max_matches": 4,
      "max_source_generation": 1,
      "min_matches": 4,
      "min_source_generation": 1,
      "min_time_span": 2.5,
      "paused": false,
      "seeking": false
    },
    {
      "action": "snapshot",
      "ended": false,
      "has_audio": true,
      "has_video": true,
      "label": "rtsp-live-g2",
      "max_matches": 4,
      "max_source_generation": 2,
      "min_matches": 4,
      "min_source_generation": 2,
      "min_time_span": 2.5,
      "paused": false,
      "seeking": false
    },
    {
      "action": "snapshot",
      "ended": false,
      "has_audio": true,
      "has_video": true,
      "label": "rtsp-live-g3",
      "max_matches": 4,
      "max_source_generation": 3,
      "min_matches": 4,
      "min_source_generation": 3,
      "min_time_span": 2.5,
      "paused": false,
      "seeking": false
    }
  ],
  "expected_driver_sha256": "@DRIVER_SHA256@",
  "expected_exit_code": 0,
  "expected_result": "pass",
  "expected_scenario_sha256": "@SCENARIO_SHA256@",
  "forbidden_events": [
    "ERROR",
    "STREAMRENDERINGERROR",
    "SEEKING",
    "SEEKED"
  ],
  "max_audio_nonzero_silence_ms": 750,
  "max_audio_silence_ms": 750,
  "max_media_error_events": 0,
  "max_source_generations": 3,
  "max_time_regression": 0.1,
  "max_timeout_snapshots": 0,
  "min_action_counts": {
    "load": 1,
    "play": 3,
    "replace": 2,
    "snapshot": 12,
    "wait_event": 6,
    "wait_ms": 12
  },
  "min_audio_bytes_generation": 4096,
  "min_audio_nonzero_units_generation": 20,
  "min_audio_samples_generation": 10,
  "min_playback_advance": 2.5,
  "min_source_generations": 3,
  "require_audio_each_generation": true,
  "require_av_same_snapshot_each_generation": true,
  "require_video_each_generation": true,
  "required_actions": [
    "load",
    "play",
    "replace",
    "snapshot",
    "shutdown"
  ],
  "required_audio_payload_formats": [
    "pcm16",
    "pcm32",
    "float32"
  ],
  "required_events": [
    "CANPLAY",
    "PLAYING"
  ],
  "required_events_per_generation": [
    "CANPLAY",
    "PLAYING"
  ]
}
