# Quotes preserve query strings and spaces in a fixture URL.
load "http://10.0.2.2:8080/vod/av.mp4?case=seek"
wait_event CANPLAY 15000
play
wait_event PLAYING 5000
wait_time 2.0 15000

# Aggressive alternating seeks. Each seek starts a new timeline generation.
loop 4
seek 12.0
wait_event SEEKED 5000
wait_time 13.0 5000
snapshot "post-seek-steady"
seek 3.0
wait_event SEEKED 5000
wait_time 4.0 5000
snapshot "post-seek-steady"
endloop

pause
wait_event PAUSE 5000
wait_ms 500
snapshot "paused-hold"
play
wait_event PLAYING 5000
shutdown
